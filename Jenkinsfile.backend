pipeline {
    agent any
    
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        registry = "https://nexus.superpart.co.th"
        VERSION = "${env.BUILD_ID}"
        NAME = "tms-backend-prod"
        NAMESPACE = "tms-backend-prod"
        MINOR = "1.0"
        IMAGE = "nexus.superpart.co.th/spp/backend/tms-prod"
        IP = "10.1.1.152"
        REMOTE_DIR = "/home/vm01/spp-k8s/spp-tms-backend"
    }
	
    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://developer:Cloudy$Day73!Orange@gitlab.superpart.co.th/tech/tms/backend/api-tms.git'
            }
        }
        
        stage('Build & Tag Docker Image') {
            steps {
                script {
                    withCredentials([
                        file(credentialsId: 'spp-private-key', variable: 'SPP_PRIVATE_KEY'),
                        file(credentialsId: 'spp-public-key', variable: 'SPP_PUBLIC_KEY')
                    ]) {
                        sh 'rm -rf src/main/resources/certs'
                        sh 'mkdir -p src/main/resources/certs'
                        sh 'cp $SPP_PRIVATE_KEY src/main/resources/certs/private_key.pem'
                        sh 'cp $SPP_PUBLIC_KEY src/main/resources/certs/public_key.pem'
        
                        withDockerRegistry(credentialsId: 'nexus-cred', url: env.registry) {
                            sh "docker build -t ${IMAGE}:${MINOR}.${VERSION} ."
                        }
                    }
                }
            }
        }
        
        stage('Docker Image Scan') {
            steps {
                sh "trivy image --format table -o trivy-image-${VERSION}.html ${IMAGE}:${MINOR}.${VERSION}"
            }
        }
        
        stage('Docker Push Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'nexus-cred', url: env.registry) {
                        sh "docker push ${IMAGE}:${MINOR}.${VERSION}"
                    }
                }
            }
        }
        
        stage('Docker delete Image') {
            steps {
                script {
                    sh "docker rmi -f ${IMAGE}:${MINOR}.${VERSION}"
                }
            }
        }
        
        stage('Get Approval') {
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                input "Please approve to proceed with deployment"
            }
        }
        
        stage('Deploy Backend to Kubernetes') {
            steps {
                script {
                    def deployScript = """
                        # 1. สร้างโฟลเดอร์ปลายทางบน vm01 (10.1.1.152)
                        ssh -o StrictHostKeyChecking=no vm01@${IP} "mkdir -p ${REMOTE_DIR}"

                        # 2. คัดลอก Manifests ทั้งหมดในโฟลเดอร์ k8s/ ไปวางไว้บน vm01
                        scp -o StrictHostKeyChecking=no -r k8s/* vm01@${IP}:${REMOTE_DIR}/

                        # 3. อัปเดต Image Tag ใน deployment.yaml และสั่ง kubectl apply
                        ssh -o StrictHostKeyChecking=no vm01@${IP} << EOF
                        cd ${REMOTE_DIR}
                        
                        # เปลี่ยน Tag ใน deployment.yaml เป็น ${IMAGE}:${MINOR}.${VERSION}
                        sed -i 's|image: ${IMAGE}:.*|image: ${IMAGE}:${MINOR}.${VERSION}|g' deployment.yaml
                        
                        # สั่ง Deploy เข้า Kubernetes Cluster
                        kubectl apply -f .
                        
                        # รอตรวจสอบการ Rollout จนสำเร็จ
                        kubectl rollout status deployment/${NAME} -n ${NAMESPACE} --timeout=120s
                        exit
EOF
                    """
                    sh deployScript
                }
            }
        }
    }        
}
